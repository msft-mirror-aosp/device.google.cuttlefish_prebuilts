package {
    default_applicable_licenses: ["android_bootloader_prebuilts_license"],
}

// See: http://go/android-license-faq
license {
    name: "android_bootloader_prebuilts_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-GPL-2.0-only",
    ],
    // large-scale-change unable to identify any license_text files
}

prebuilt_etc_host {
    name: "cvd_avb_pubkey_rsa2048",
    filename: "cvd_rsa2048.avbpubkey",
    src: "testkey_rsa2048.avbpubkey",
}

prebuilt_etc_host {
    name: "cvd_avb_pubkey_rsa4096",
    filename: "cvd_rsa4096.avbpubkey",
    src: "testkey_rsa4096.avbpubkey",
}

prebuilt_etc_host {
    name: "bootloader_qemu_aarch64",
    filename: "bootloader.qemu",
    sub_dir: "bootloader_aarch64",
    src: "qemu_aarch64/u-boot.bin",
}

prebuilt_etc_host {
    name: "bootloader_crosvm_x86_64",
    filename: "bootloader.crosvm",
    sub_dir: "bootloader_x86_64",
    src: "crosvm_x86_64/u-boot.rom",
}

prebuilt_etc_host {
    name: "bootloader_crosvm_aarch64",
    filename: "bootloader.crosvm",
    sub_dir: "bootloader_aarch64",
    src: "crosvm_aarch64/u-boot.bin",
}

prebuilt_etc {
    name: "android_bootloader_crosvm_aarch64",
    filename: "u-boot.bin",
    src: "crosvm_aarch64/u-boot.bin",
}

prebuilt_etc {
    name: "android_bootloader_crosvm_x86_64",
    filename: "u-boot.rom",
    src: "crosvm_x86_64/u-boot.rom",
}

prebuilt_etc_host {
    name: "bootloader_qemu_arm",
    filename: "bootloader.qemu",
    sub_dir: "bootloader_arm",
    src: "qemu_arm/u-boot.bin",
}

prebuilt_etc_host {
    name: "bootloader_qemu_riscv64",
    filename: "bootloader.qemu",
    sub_dir: "bootloader_riscv64",
    src: "qemu_riscv64/u-boot.bin",
}

prebuilt_etc_host {
    name: "bootloader_qemu_x86_64",
    filename: "bootloader.qemu",
    sub_dir: "bootloader_x86_64",
    src: "qemu_x86_64/u-boot.rom",
}
